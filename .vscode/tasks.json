{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "clangd: Use PC target",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/select_clangd.py",
        "pc"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "clangd: Use STM32 target",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/select_clangd.py",
        "stm32"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "STM32: Configure Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build-stm32-debug",
        "-G",
        "Ninja",
        "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/toolchains/arm-none-eabi.cmake",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DPICKUP_BUILD_VIRTUAL_TARGET=OFF",
        "-DPICKUP_BUILD_TESTS=OFF",
        "-DPICKUP_BUILD_STM32_TARGET=ON"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "STM32: Build Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build-stm32-debug",
        "--parallel",
        "4"
      ],
      "dependsOn": "STM32: Configure Debug",
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc"
    }
  ]
}
