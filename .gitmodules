[submodule "external/ArduinoJson"]
	path = external/ArduinoJson
	url = https://github.com/bblanchon/ArduinoJson.git
[submodule "external/imgui"]
	path = external/imgui
	url = https://github.com/ocornut/imgui.git
[submodule "external/glfw"]
	path = external/glfw
	url = https://github.com/glfw/glfw.git
[submodule "external/stm32g4xx-hal-driver"]
	path = external/stm32g4xx-hal-driver
	url = https://github.com/STMicroelectronics/stm32g4xx-hal-driver.git
[submodule "external/cmsis-device-g4"]
	path = external/cmsis-device-g4
	url = https://github.com/STMicroelectronics/cmsis-device-g4.git
[submodule "external/CMSIS_5"]
	path = external/CMSIS_5
	url = https://github.com/ARM-software/CMSIS_5.git
